# Every variable the app reads. Copy to .env (gitignored) and fill in. src/env.ts validates them:
# a production server refuses to start when a required one is missing; development only logs.

# --- Database (Supabase) ---
# Local dev (Homebrew PostgreSQL 17 on port 5433) uses the same value for both:
#   DATABASE_URL=postgresql://jawad@localhost:5433/dishrank
#   DIRECT_URL=postgresql://jawad@localhost:5433/dishrank
# Required. Runtime connection via @prisma/adapter-pg: Supavisor transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<n>-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Required. Prisma CLI (migrate, seed) via prisma.config.ts: Supavisor session pooler (port 5432);
# the free-plan direct host is IPv6-only and Vercel builds are IPv4.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-<n>-ap-south-1.pooler.supabase.com:5432/postgres

# --- Better Auth ---
# Required, 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required. Public base URL of this deployment.
BETTER_AUTH_URL=http://localhost:3000
# Required in production. Google OAuth client; redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. The first admin: this email gets role ADMIN on first sign-in.
ADMIN_EMAIL=

# --- Supabase Storage (used from Phase 3) ---
# Project URL of the Supabase project (local dev uses the preview project).
SUPABASE_URL=
# Server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public read; random cuid file names; writes only via signed upload URLs.
SUPABASE_DISH_PHOTOS_BUCKET=dish-photos
# Private; menu photos, read server-side with the service role key.
SUPABASE_MENUS_BUCKET=menus

# --- Google Places (Phase 2: seeding + daily location refresh only) ---
GOOGLE_PLACES_API_KEY=

# --- Anthropic ---
# Optional until Phase 1; without it the dish matcher skips the LLM step.
ANTHROPIC_API_KEY=
# A current Claude model id for menu-photo parsing (Phase 5).
ANTHROPIC_VISION_MODEL=
# A small/fast Claude model id for the dish matcher (Phase 1), e.g. claude-haiku-5-5. The LLM step
# runs only when both ANTHROPIC_API_KEY and this are set.
ANTHROPIC_MATCH_MODEL=

# --- App ---
# Optional. Public site URL used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required, 32+ characters: openssl rand -hex 32. /api/cron/* refuse every request without it.
CRON_SECRET=
# Set by Next.js itself (development for `pnpm dev`, production for build/start); do not set it in .env.
# NODE_ENV=development

# --- Set by the platform, never in .env ---
# NEXT_PHASE, NEXT_RUNTIME (Next.js), CI (GitHub Actions; Playwright retries and forbidOnly)
