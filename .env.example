# Every variable the app reads. Copy to .env (gitignored) and fill in. src/env.ts validates them:
# a production server refuses to start when a required one is missing; development only logs.

# --- Database (Supabase) ---
# Local dev (Homebrew PostgreSQL 17 on port 5433) uses the same value for both:
#   DATABASE_URL=postgresql://jawad@localhost:5433/dishrank
#   DIRECT_URL=postgresql://jawad@localhost:5433/dishrank
# Required. Runtime connection via @prisma/adapter-pg (also the seed and overture:sync): Supavisor
# transaction pooler (port 6543). Copy host and user from Supabase → Connect. No sslmode: the app
# verifies Supabase's certificate itself (src/server/db-ssl.ts) and src/env.ts refuses one here.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<n>-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Required. Prisma CLI only (migrate deploy) via prisma.config.ts: Supavisor session pooler (port
# 5432); the free-plan direct host is IPv6-only and Vercel builds are IPv4.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-<n>-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Better Auth ---
# Required, 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required. Public base URL of this deployment.
BETTER_AUTH_URL=http://localhost:3000
# Required in production. Google OAuth client; redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. The first admin: this email gets role ADMIN on first sign-in.
ADMIN_EMAIL=
# Beta only (SITE_MODE=beta). Google accounts allowed to create an account, besides ADMIN_EMAIL:
# comma-separated e-mail addresses. Google's "Testing" status does not limit plain Sign in with
# Google, so the app checks this list. Empty = only ADMIN_EMAIL can sign up.
BETA_ALLOWED_EMAILS=

# --- Supabase Storage (used from Phase 3) ---
# Project URL of the Supabase project (local dev uses the preview project).
SUPABASE_URL=
# Server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public read; keys <userId>/<random>.<ext>; writes only via presigned upload URLs.
SUPABASE_DISH_PHOTOS_BUCKET=dish-photos
# Private bucket for menu photos (Phase 5), reached through the same S3 keys: uploads with
# 10-minute signed URLs, read on the server for parsing, shown to admins through 10-minute links.
SUPABASE_MENUS_BUCKET=menus
# Optional (Phase 3): dish photo uploads through Supabase Storage's S3 protocol, so upload URLs
# expire after 10 minutes. Dashboard → Storage → Configuration → S3: enable it, copy the
# endpoint (https://<project-ref>.storage.supabase.co/storage/v1/s3) and region, and create an
# access key (server only: it bypasses storage policies). Set all four, or none to hide photos.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Anthropic ---
# Optional. Without it the dish matcher skips the LLM step and menu photos wait unparsed (uploads
# still work). Never logged.
ANTHROPIC_API_KEY=
# A current Claude model id for menu-photo parsing (Phase 5), e.g. claude-sonnet-5-5. Parsing runs
# only when both ANTHROPIC_API_KEY and this are set; at most 50 parses start in any 24 hours.
ANTHROPIC_VISION_MODEL=
# A small/fast Claude model id for the dish matcher (Phase 1), e.g. claude-haiku-5-5. The LLM step
# runs only when both ANTHROPIC_API_KEY and this are set.
ANTHROPIC_MATCH_MODEL=

# --- App ---
# Optional. Public site URL used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required, 32+ characters: openssl rand -hex 32. /api/cron/* refuse every request without it.
CRON_SECRET=
# Optional: beta or live. beta = private beta: noindex on every page and response, robots.txt
# disallows everything, empty sitemap, a "Beta" label. live = the public site. Unset means beta in
# production and live in development; any other value stops a production server at startup (the
# build then treats it as beta). Read at build time: after changing it, redeploy.
SITE_MODE=
# Optional. Who runs the site and how to reach them, shown on /privacy and /terms (a visible
# placeholder appears while unset).
OPERATOR_NAME=
CONTACT_EMAIL=
# Set by Next.js itself (development for `pnpm dev`, production for build/start); do not set it in .env.
# NODE_ENV=development

# --- Vercel only (a project setting, not for .env) ---
# ENABLE_EXPERIMENTAL_COREPACK=1 makes the Vercel build use package.json packageManager (pnpm 12.14.0).

# --- Set by the platform, never in .env ---
# NEXT_PHASE, NEXT_RUNTIME (Next.js), CI (GitHub Actions; Playwright retries and forbidOnly),
# VERCEL_ENV (Vercel: production | preview | development; scripts/vercel-build.ts migrates only on production)
