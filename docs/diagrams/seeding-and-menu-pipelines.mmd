flowchart LR
  subgraph Seed["Candidate import (Overture Maps, every restaurant reviewed)"]
    S["pnpm overture:sync<br/>Meta + Microsoft food places"] --> Q["OvertureCandidate NEW<br/>city, suggested area"]
    Q --> Imp["/admin/import: Create (prefilled form,<br/>admin corrects) / Link / Skip"]
    Imp --> RD0["RestaurantDish CANDIDATE<br/>source ADMIN conf 0.4 per ticked dish"]
  end
  subgraph Menu["Menu ingestion"]
    Up["Panel/owner uploads menu photo"] --> ST["Supabase Storage menus/"]
    ST --> MU["MenuUpload PENDING"]
    MU --> V["VisionService (Anthropic)<br/>image → JSON sections/items"]
    V --> MI["MenuItem rows"]
    MI --> M["MatchingService<br/>normalize → alias → trigram → LLM"]
    M -->|conf ≥ 0.85| RDV["RestaurantDish MENU_VERIFIED"]
    M -->|else| RQ["ReviewItem UNMATCHED_MENU_ITEM"]
    RQ --> Adm["Admin resolves"] --> RDV
  end
  subgraph Users["User ratings"]
    Rt["Rating submitted"] --> RDU["RestaurantDish CANDIDATE → USER_CONFIRMED<br/>at 3 distinct raters"]
  end
  RD0 --> Rank["RankingService<br/>eligible only when status confirmed/verified<br/>AND thresholds met"]
  RDV --> Rank
  RDU --> Rank
