// Copied from docs/03-DATA-MODEL.md (authoritative). Edit docs/03 first, then this file.

generator client {
  provider = "prisma-client" // Prisma 7 generator (prisma-client-js is deprecated)
  output   = "../src/generated/prisma" // required in Prisma 7; import PrismaClient from here
}

datasource db {
  provider = "postgresql"
  // Prisma 7 keeps connection URLs out of the schema:
  // - CLI (migrate, db seed): prisma.config.ts → datasource.url = env("DIRECT_URL")
  // - runtime: src/server/db.ts → new PrismaClient({ adapter: new PrismaPg({ connectionString: process.env.DATABASE_URL }) })
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum RestaurantStatus {
  ACTIVE
  CLOSED
  DUPLICATE
  HIDDEN
}

enum RestaurantDishStatus {
  CANDIDATE
  USER_CONFIRMED
  MENU_VERIFIED
  OWNER_VERIFIED
  STALE
  REMOVED
}

enum SourceType {
  PANEL
  USER
  OWNER
  MENU_PHOTO
  ADMIN
  AUTO_LIST // read from the place's name or category by the Auto-list (docs/07 §2a); never checked by a person
}

enum RatingStatus {
  ACTIVE
  HELD
  HIDDEN
}

enum MenuUploadStatus {
  PENDING
  PARSED
  FAILED
  REVIEWED
}

/// One menu item's state on /admin/menus (docs/07 §3): matched (automatically at ≥ 0.85, or by an
/// admin), waiting for a decision (an OPEN UNMATCHED_MENU_ITEM review item), or ignored by an admin.
enum MenuItemStatus {
  MATCHED
  NEEDS_REVIEW
  IGNORED
}

enum MatchMethod {
  ALIAS
  TRIGRAM
  LLM
  HUMAN
  NONE
}

enum ReviewItemType {
  UNMATCHED_MENU_ITEM
  DISH_PROPOSAL
  RESTAURANT_PROPOSAL
  FLAG
  SUSPICIOUS_RATINGS
  OWNER_CLAIM
  DUPLICATE_RESTAURANT
  LOCATION_SUGGESTION
}

enum ReviewItemStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum FlagReason {
  NOT_SERVED
  WRONG_DISH
  RESTAURANT_CLOSED
  DUPLICATE
  OTHER
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Where a restaurant record came from (OWNER arrives with owner sign-ups, Phase 6).
enum RestaurantSource {
  OVERTURE
  MANUAL
}

/// Where a restaurant's lat/lng came from.
enum LocationSource {
  OVERTURE
  ADMIN
  PANEL_GPS // an admin accepted a panel member's on-site location (docs/07 §7)
}

/// Review state of an Overture place (docs/07 §2).
enum CandidateStatus {
  NEW
  CREATED
  LINKED
  SKIPPED
}

enum CandidateSkipReason {
  CLOSED
  DUPLICATE
  NOT_A_RESTAURANT
}

// ---------- Auth (Better Auth) ----------
// User, Session, Account and Verification carry Better Auth's core fields (prismaAdapter, provider "postgresql").
// Better Auth runs with advanced.database.generateId = false, so ids come from these Prisma defaults like every other table.
// `role` is declared to Better Auth as user.additionalFields.role { type: "string", input: false, defaultValue: "USER" }:
// it is returned on the session user but can never be set by the client. The other app fields are invisible to Better Auth.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  Boolean   @default(false)
  name           String // required by Better Auth; Google always sends a name
  image          String?
  username       String?   @unique
  role           Role      @default(USER)
  trustScore     Float     @default(0.6) // 0.3 .. 1.5, see docs/04: the trust used at compute time
  trustOverride  Float? // set by an admin on /admin/users (0.3 .. 1.5); wins over the trust table, also the nightly job's
  isPanel        Boolean   @default(false) // admin-only (never Better Auth input); trust 1.0 unless trustOverride is set (2026-11-11; 1.3 before), panel limits in docs/04
  panelRemovedAt DateTime? // an admin turned the panel off: an invite link does not put them back (docs/07 §7a)
  source         String? // where the account came from (docs/01 D1b): the ?s= tag of the visit it signed up in, or the invite link's label; set once at sign-up, never shown (2026-11-11)
  ratingsCount   Int       @default(0)
  photoRatings   Int       @default(0)
  bannedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  ratings              Rating[]
  flags                Flag[]
  claims               OwnerClaim[]
  reviewedClaims       OwnerClaim[]          @relation("claimReviewer")
  uploads              Upload[]
  menuUploads          MenuUpload[]
  resolvedItems        ReviewItem[]          @relation("resolver")
  createdItems         ReviewItem[]          @relation("creator")
  claimedRestaurants   Restaurant[]
  reviewedCandidates   OvertureCandidate[]
  locationObservations LocationObservation[]
  panelInvites         PanelInvite[]
  panelInviteUses      PanelInviteUse[]
}

/// Banned Google accounts, as one-way hashes of their e-mail address (an HMAC of the trimmed,
/// lowercased address, keyed from IP_HASH_SECRET, src/server/email-hash.ts). Written when an admin bans a user and when a
/// banned user deletes the account; checked at sign-up, so the same account cannot come back
/// (audit 2026-11, A-01). The hash cannot be turned back into the address.
model BannedEmail {
  emailHash String   @id
  createdAt DateTime @default(now())
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String // the provider's user id (Google "sub")
  providerId            String // "google"
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Better Auth core field; unused (Google sign-in only)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // value of the session cookie
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Geography ----------
model City {
  id          String              @id @default(cuid())
  slug        String              @unique // islamabad, rawalpindi
  name        String
  lat         Float
  lng         Float
  launchedAt  DateTime? // NULL until an admin presses "End early rankings in 60 days" on /admin/rankings; bootstrap thresholds while NULL and for 60 days after
  featuredClosesAt DateTime? // voting for the featured round's results closes then (end of day, Pakistan); the line is hidden after it, the ranking never closes
  featuredRound    String? // the round's name, e.g. "winter results" ("Voting for the winter results closes Sun 20 Dec")
  areas       Area[]
  restaurants Restaurant[]
  dishStats   DishStat[]
  candidates  OvertureCandidate[]
  featured    FeaturedDish[]
}

/// One or two dishes a city's home page leads with (docs/01 Home, 2026-11-11), in position order;
/// set on /admin/rankings, seeded from seed/cities.json when a city has none.
model FeaturedDish {
  id        String   @id @default(cuid())
  cityId    String
  dishId    String
  position  Int // 1 or 2
  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id])

  @@unique([cityId, dishId])
  @@unique([cityId, position])
}

model Area {
  id          String              @id @default(cuid())
  cityId      String
  slug        String // f-7, saddar
  name        String
  lat         Float
  lng         Float
  radiusKm    Float               @default(1.5) // Overture candidates within this distance of the centre get it suggested (seed/areas.json)
  city        City                @relation(fields: [cityId], references: [id])
  restaurants Restaurant[]
  candidates  OvertureCandidate[]

  @@unique([cityId, slug])
}

// ---------- Restaurants ----------
model Restaurant {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  cityId          String
  areaId          String?
  address         String?
  lat             Float? // our own: from Overture or typed by an admin (locationSource); NULL = location unknown
  lng             Float?
  locationSource  LocationSource? // NULL exactly when lat/lng are NULL
  phone           String?
  website         String?
  priceBand       Int? // 1..4
  source          RestaurantSource // how the record was created; never changes
  overtureId      String?          @unique // GERS id of the Overture place it was created from or linked to
  status          RestaurantStatus @default(ACTIVE)
  aliases         String[]         @default([]) // other names typed by an admin ("but karahi"), docs/05
  searchText      String           @default("") // cleaned name + aliases, maintained by RestaurantService, for pg_trgm
  claimedByUserId String?
  claimedAt       DateTime?
  mergedIntoId    String? // set with status DUPLICATE; its URLs redirect permanently to this restaurant
  autoListedAt    DateTime? // created by the Auto-list (docs/07 §2a); NULL = created by a person
  checkedAt       DateTime? // an admin confirmed or edited an auto-listed restaurant
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  city                 City                  @relation(fields: [cityId], references: [id])
  mergedInto           Restaurant?           @relation("merge", fields: [mergedIntoId], references: [id])
  mergedFrom           Restaurant[]          @relation("merge")
  area                 Area?                 @relation(fields: [areaId], references: [id])
  claimedBy            User?                 @relation(fields: [claimedByUserId], references: [id])
  dishes               RestaurantDish[]
  menuUploads          MenuUpload[]
  claims               OwnerClaim[]
  reviewItems          ReviewItem[]
  candidates           OvertureCandidate[]
  locationObservations LocationObservation[]

  @@index([cityId, status])
  @@index([cityId, areaId])
  @@index([autoListedAt, checkedAt])
  // Trigram index, created by the raw SQL migration after pg_trgm exists; declared here so Prisma does not drop it.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "restaurants_search_trgm")
}

// ---------- Overture candidates (docs/07 §1-2) ----------
// Overture Maps places staged for admin review by `pnpm overture:sync`: food and drink places from
// Meta and Microsoft only (CDLA Permissive 2.0). A later release only adds GERS ids not seen before;
// existing rows keep their data and review state (only lastSeenRelease moves forward).
model OvertureCandidate {
  id               String               @id @default(cuid())
  overtureId       String               @unique // GERS id
  release          String // the release its data comes from (a newer one refreshes a NEW row), e.g. 2026-10-21.0
  lastSeenRelease  String // newest synced release that still had it
  cityId           String // city of the nearest seed area centre
  suggestedAreaId  String? // the seed area whose radius covers the point (deepest inside); NULL when none or location unknown
  name             String
  address          String? // Overture's freeform address without Google links
  phone            String?
  website          String? // first website that is not a Google link
  category         String? // Overture taxonomy primary, e.g. pizza_restaurant
  alternates       String[]             @default([]) // Overture taxonomy alternates
  confidence       Float // Overture's existence score, 0..1 (relative, no threshold)
  lat              Float? // NULL = location unknown (Overture's point is a placeholder)
  lng              Float?
  sources          String[] // Overture datasets of the whole record: meta, Microsoft
  status           CandidateStatus      @default(NEW)
  skipReason       CandidateSkipReason?
  restaurantId     String? // CREATED or LINKED: the restaurant
  reviewedByUserId String?
  reviewedAt       DateTime?
  autoListedAt     DateTime? // CREATED by the Auto-list (docs/07 §2a); `name` stays Overture's original for audit
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  city          City        @relation(fields: [cityId], references: [id])
  suggestedArea Area?       @relation(fields: [suggestedAreaId], references: [id])
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])
  reviewedBy    User?       @relation(fields: [reviewedByUserId], references: [id])

  @@index([cityId, status, suggestedAreaId])
  @@index([restaurantId])
}

// A panel member's browser location while rating at a restaurant (docs/07 §7). Kept apart from the
// rating, and only when the browser reports an accuracy of 50 m or better. Restaurants without a
// location, or far from it, get a LOCATION_SUGGESTION review item; accepting it sets PANEL_GPS.
model LocationObservation {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  lat          Float
  lng          Float
  accuracyM    Float // browser-reported accuracy radius in metres (≤ 50)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

// ---------- Dish taxonomy ----------
model DishCategory {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)
  dishes    Dish[]
}

model Dish {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  categoryId  String
  description String?
  isLaunch    Boolean  @default(false)
  createdAt   DateTime @default(now())

  category         DishCategory     @relation(fields: [categoryId], references: [id])
  aliases          DishAlias[]
  restaurantDishes RestaurantDish[]
  menuItems        MenuItem[]
  dishStats        DishStat[]
  reviewItems      ReviewItem[]
  featured         FeaturedDish[]
}

// One row per spelling of a dish; the dish name is stored as an alias too.
// Matching and dish search compare the query with one alias at a time (docs/05), never a concatenated string.
model DishAlias {
  id        String   @id @default(cuid())
  dishId    String
  alias     String   @unique // stored normalised (docs/05 step 1): lowercase ASCII words, single spaces
  createdAt DateTime @default(now())

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
  // Trigram index, created by the raw SQL migration after pg_trgm exists; declared here so Prisma does not drop it.
  @@index([alias(ops: raw("gin_trgm_ops"))], type: Gin, map: "dish_alias_trgm")
}

// ---------- The core join: restaurant serves dish ----------
model RestaurantDish {
  id               String               @id @default(cuid())
  restaurantId     String
  dishId           String
  cityId           String // denormalised for ranking queries
  menuName         String?
  price            Int? // PKR
  variantTags      String[]             @default([])
  status           RestaurantDishStatus @default(CANDIDATE)
  source           SourceType
  confidence       Float                @default(0.4)
  // aggregates maintained by RankingService
  ratingCount      Int                  @default(0)
  distinctRaters   Int                  @default(0)
  weightSum        Float                @default(0)
  eligibilityWeight Float                @default(0) // Σ trust of the counted ratings, no decay: eligibility only (docs/04, 2026-11-13); weightSum (decayed) drives the score
  weightedScoreSum Float                @default(0)
  rawMean          Decimal?             @db.Decimal(5, 3)
  score            Decimal?             @db.Decimal(5, 3)
  rankInCity       Int?
  lastRatedAt      DateTime?
  lastVerifiedAt   DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish       Dish       @relation(fields: [dishId], references: [id])
  ratings    Rating[]
  flags      Flag[]

  @@unique([restaurantId, dishId])
  @@index([cityId, dishId, status, score(sort: Desc)])
  @@index([dishId, status])
}

// ---------- Ratings ----------
model Rating {
  id               String       @id @default(cuid())
  restaurantDishId String
  userId           String
  score            Int // 1..10
  taste            Int? // 1..5
  portion          Int? // 1..5
  value            Int? // 1..5
  comment          String? // <= 280 chars
  photoPath        String?      @unique // storage path; one photo belongs to one rating (docs/06)
  status           RatingStatus @default(ACTIVE)
  weight           Float        @default(1) // rater's trustScore at write time, for the record only; scores use trust at compute time (docs/04)
  ipHash           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  restaurantDish RestaurantDish  @relation(fields: [restaurantDishId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id])
  history        RatingHistory[]

  @@unique([restaurantDishId, userId])
  @@index([userId, createdAt])
  @@index([restaurantDishId, status, createdAt])
}

model RatingHistory {
  id        String   @id @default(cuid())
  ratingId  String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
}

// Phase 7 — pairwise votes (table created now, unused in v1)
model PairwiseVote {
  id         String   @id @default(cuid())
  dishId     String
  cityId     String
  winnerRdId String
  loserRdId  String
  userId     String
  createdAt  DateTime @default(now())

  @@index([cityId, dishId])
}

// ---------- Menus ----------
model MenuUpload {
  id               String           @id @default(cuid())
  restaurantId     String
  uploadedByUserId String? // null once the uploader deleted their account (the menu stays)
  filePath         String           @unique // menus/<restaurantId>/<uploaderId>/<random>.(jpg|webp)
  status           MenuUploadStatus @default(PENDING)
  rawJson          Json?
  error            String?
  createdAt        DateTime         @default(now())
  parsedAt         DateTime?

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  items      MenuItem[]
  parses     MenuParse[]

  @@index([status, createdAt])
}

model MenuItem {
  id              String         @id @default(cuid())
  menuUploadId    String
  position        Int            @default(0) // order on the menu photo, from 0
  rawName         String // as printed, in any script
  romanName       String? // the vision model's Roman-Urdu spelling when rawName is not in Latin letters
  rawPrice        Int?
  rawSection      String?
  matchedDishId   String?
  matchConfidence Float? // docs/05: ALIAS 1.0 / 0.75 / 0.60 · TRIGRAM similarity, max 0.80 · LLM; ≥ 0.85 auto, 0.45–0.85 review with suggestions
  matchMethod     MatchMethod    @default(NONE)
  variantTags     String[]       @default([])
  status          MenuItemStatus @default(NEEDS_REVIEW)
  reviewItemId    String?        @unique // its UNMATCHED_MENU_ITEM item, when it needed one
  createdAt       DateTime       @default(now())

  menuUpload  MenuUpload  @relation(fields: [menuUploadId], references: [id], onDelete: Cascade)
  matchedDish Dish?       @relation(fields: [matchedDishId], references: [id])
  reviewItem  ReviewItem? @relation(fields: [reviewItemId], references: [id], onDelete: SetNull)

  @@index([menuUploadId])
}

/// One parse attempt of a menu photo (docs/07 §3): the vision call's model and tokens, and the
/// matcher's LLM calls. The daily cap counts these rows; an unfinished one marks a parse in progress.
model MenuParse {
  id                String    @id @default(cuid())
  menuUploadId      String
  trigger           String // admin | cli | cron
  model             String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  ok                Boolean?
  error             String?
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  matchCalls        Int       @default(0)
  matchInputTokens  Int       @default(0)
  matchOutputTokens Int       @default(0)

  menuUpload MenuUpload @relation(fields: [menuUploadId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([menuUploadId, startedAt])
}

// ---------- Moderation ----------
model ReviewItem {
  id               String           @id @default(cuid())
  type             ReviewItemType
  status           ReviewItemStatus @default(OPEN)
  payload          Json // type-specific (see docs/07)
  restaurantId     String?
  dishId           String?
  createdByUserId  String?
  resolvedByUserId String?
  resolution       String?
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  dish       Dish?       @relation(fields: [dishId], references: [id])
  createdBy  User?       @relation("creator", fields: [createdByUserId], references: [id])
  resolvedBy User?       @relation("resolver", fields: [resolvedByUserId], references: [id])
  menuItem   MenuItem?

  @@index([status, type, createdAt])
}

model Flag {
  id               String         @id @default(cuid())
  restaurantDishId String
  userId           String
  reason           FlagReason
  note             String?
  upheld           Boolean?
  createdAt        DateTime       @default(now())
  restaurantDish   RestaurantDish @relation(fields: [restaurantDishId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantDishId, userId, reason])
}

model OwnerClaim {
  id               String      @id @default(cuid())
  restaurantId     String
  userId           String
  phone            String
  proofNote        String?
  status           ClaimStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectReason     String? // shown to the claimant on /me
  restaurant       Restaurant  @relation(fields: [restaurantId], references: [id])
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?       @relation("claimReviewer", fields: [reviewedByUserId], references: [id])

  @@index([status])
  @@index([userId, restaurantId])
}

// ---------- Stats & ops ----------
model DishStat {
  cityId      String
  dishId      String
  meanScore   Float // city-wide weighted mean = Bayesian prior C
  ratingCount Int
  updatedAt   DateTime @updatedAt
  city        City     @relation(fields: [cityId], references: [id])
  dish        Dish     @relation(fields: [dishId], references: [id])

  @@id([cityId, dishId])
}

model RankingSnapshot {
  id         String   @id @default(cuid())
  cityId     String
  dishId     String
  computedAt DateTime @default(now())
  payload    Json // [{restaurantDishId, rank, score, votes}]

  @@index([cityId, dishId, computedAt])
}

model RateLimitBucket {
  key         String // e.g. "user:abc:rating"
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}

/// A signed upload (Phase 6): who may use the file. Storage paths are random and never contain the
/// user id; a rating or menu accepts a path only when its Upload row is the caller's. The nightly
/// clean-up deletes files no rating or menu has used for 24 hours, with their row.
enum UploadKind {
  DISH_PHOTO
  MENU
}

model Upload {
  id           String     @id @default(cuid())
  userId       String
  kind         UploadKind
  path         String     @unique // dish-photos/<random>.<ext> or menus/<restaurantId>/<random>.<ext>
  restaurantId String? // menus: the restaurant the photo was signed for
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

/// Light analytics (owner, Phase 6): what was looked at, never who. No user, no IP, no exact time.
enum AnalyticsEventName {
  RATING_SUBMITTED
  SEARCH
  RANKING_VIEW
  SHARE_CLICK
  SIGN_IN_STARTED // "Continue with Google" in a normal browser
  SIGN_IN_COMPLETED
  IN_APP_SIGN_IN_STARTED // reached a sign-in step inside an app's built-in browser (Facebook, Instagram, Messenger, TikTok, LinkedIn and the rest; docs/12 Sign in)
  IN_APP_LEFT_BROWSER // tapped "Open in Chrome" or "Copy link" there
  IN_APP_SIGN_IN_COMPLETED // finished in Chrome or Safari, after leaving one of those browsers
}

model AnalyticsEvent {
  id       String             @id @default(cuid())
  name     AnalyticsEventName
  citySlug String?
  dishSlug String?
  source   String? // the visit's ?s= tag (a browser event) or the rater's account source (a rating): a channel, never who (docs/01 D1b, 2026-11-11)
  day      DateTime           @db.Date // the day in Pakistan (UTC+5), not the moment

  @@index([name, day])
  @@index([day])
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    Json?
}

/// Panel invite links on /admin/users (docs/07 §7a). Only the sha256 of the token is stored: the link
/// is shown once. Signing in through one makes the user a panel member and passes the beta allowlist.
model PanelInvite {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  label           String
  maxUses         Int       @default(30)
  usesCount       Int       @default(0) // raised under the row lock; never above maxUses
  expiresAt       DateTime
  revokedAt       DateTime?
  createdByUserId String? // null once that admin deleted their account
  createdAt       DateTime  @default(now())

  createdBy User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  uses      PanelInviteUse[]

  @@index([createdAt])
}

/// Who joined through a link. One row per user per link.
model PanelInviteUse {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String
  createdAt DateTime @default(now())

  invite PanelInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([userId])
}

/// Unexpected server errors (docs/02 Observability): the route pattern, the error's name, a short
/// scrubbed message and Next.js's digest. Never a user, a path with ids, a header or a query. The
/// last 50 show on /admin; the nightly run deletes rows older than 30 days.
model ServerError {
  id        String   @id @default(cuid())
  route     String
  name      String
  message   String
  digest    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
