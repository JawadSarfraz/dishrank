{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(* ./.env)",
      "Bash(* ./.env *)",
      "Bash(* .env.local)",
      "Bash(* .env.local *)",
      "Bash(* ./.env.local)",
      "Bash(* ./.env.local *)"
    ]
  }
}
